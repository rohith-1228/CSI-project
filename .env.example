# CyberSaathi Environment Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed origins. Use "*" only for local testing or set specific frontend URLs in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Maximum message length allowed for analysis (characters)
MAX_MESSAGE_LENGTH=5000

# Model Configuration
MODEL_PATH=models/cybersaathi_text_classifier_v1.joblib
MODEL_METADATA_PATH=models/model_metadata.json

# Frontend Configuration (for Vite)
# Set in frontend/.env or as Vercel environment variable
VITE_API_BASE_URL=http://localhost:8000
